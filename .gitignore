# Godot recreates this cache from project sources. Tracking it produces binary
# churn on every editor, test, and renderer run.
/.godot/
/artifacts/
/build/
/CURRENT_PLAYTEST_FRESHNESS.json
/HUMAN_PLAYTEST.md
*.uid
*.gd.uid
__pycache__/
*.pyc
assets/terrain_textures/material_layers/*.url

# Godot editor sidecars for generated shaders and retained evidence images.
/addons/world_transvoxel_terrain/gpu/*.glsl.import
/docs/evidence/**/*.import

# Raw exploratory capture set retained locally. Its reviewed conclusions belong
